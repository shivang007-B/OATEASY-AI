# ==============================================================================
# OatEasy AI - Environment Configuration
# ==============================================================================

# Server Port (Default: 8000)
PORT=8000

# ==============================================================================
# COPAYFLOW / YOUPI PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
# Localhost development: http://localhost:7000
# Production: Set to your public Gateway Domain (e.g. https://pay.yourdomain.com)
# If left empty or unreachable, OatEasy AI automatically uses its built-in self-hosted checkout!
YOUPI_GATEWAY_URL=http://localhost:7000

# Merchant Public API Key (Default demo key)
YOUPI_MERCHANT_KEY=00000000-0000-0000-0000-000000000001

# Webhook HMAC-SHA256 Secret (Used to cryptographically verify payment webhooks)
YOUPI_WEBHOOK_SECRET=merchant_webhook_secret_for_wallet_store

# Currency (Default: INR)
YOUPI_CURRENCY=INR

# Optional Custom Script URL (Defaults to /static/youpi.js bundled inside OatEasy)
# YOUPI_SCRIPT_URL=https://pay.yourdomain.com/youpi.js

